{
  "version": 2,
  "protectionMarker": "pipeline.config.json",
  "roles": {
    "test-author": {
      "summary": "one controller-owned acceptance suite authoring session",
      "scope": "issue-suite",
      "pathClasses": ["frozen"]
    }
  },
  "pathClasses": {
    "frozen": ["tests/acceptance/**"],
    "control": ["AGENTS.md", "contracts/**", "runner/control-plane.js"],
    "config": ["pipeline.config.json", "run.config.*.json", ".gitignore", ".gitattributes"],
    "planning": ["PLANNING.md", "DESIGN.md", "ONBOARDING.md", "SETUP.md", "README.md", "CLAUDE.md", "docs/**", "plans/**"],
    "product": ["backend/**", "frontend/**", "runner/**", "scripts/**", "pipeline/**", "docker/**", "advisors/**", "beads/**", "tools/**", "schemas/**", "tests/**", "src/**", "lib/**", "app/**", "bin/**", "Dockerfile", "Makefile", "package.json"]
  },
  "classPrecedence": ["frozen", "control", "config", "planning", "product"],
  "admissionClasses": ["product", "config", "frozen", "control"],
  "denyReasons": ["pipeline-first", "role-path", "lease-invalid", "test-author-shell", "unknown-write-form", "unknown-shell-form", "unknown-patch-form", "interpreter-write", "destructive-git"],
  "clientStates": ["enforced", "degraded", "disabled", "unsupported", "uninstalled", "untrusted"],
  "clients": {
    "claude": {"toolPaths": ["Write", "Edit", "MultiEdit", "NotebookEdit", "Bash", "PowerShell"], "configFile": "settings.json"},
    "codex": {"toolPaths": ["Bash", "apply_patch"], "configFile": "config.toml"}
  }
}
