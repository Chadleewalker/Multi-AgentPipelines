# Per-run logs, manifests, and reports (DESIGN.md §4.12) — host-only, never committed.
runs/

node_modules/
.env
.env.*

# Per-project runner configs name a local path and a real remote — host-only.
# Copy run.config.example.json to make your own (ONBOARDING.md step 8).
run.config.*.json
!run.config.example.json

# The publication denylist names the private things that must never appear in this public
# tree, so committing it would publish exactly what it protects. Host-only; copy
# .sanitize-denylist.example to make your own (scripts/test-sanitize.sh).
.sanitize-denylist

# A filled-in user profile describes a person, not the machinery — the same boundary that
# keeps runs/ out. Host-only; copy docs/user-profile.example.md to make your own, and put
# the live copy at ~/.claude/CLAUDE.md (the template says why).
docs/user-profile.md

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Agent hooks are host-only: this repo is cloned into task containers that have no bd.
# Enforced by scripts/test-agent-hooks.sh (change-log row `agent-hooks-untracked`).
.codex/hooks.json
.claude/hooks/
.codex/hooks/
.claude/settings.local.json

# Which git-ignored host-only files a new worktree should be given
# (docs/parallel-sessions.md §7). It names local paths, so it is host-only itself; copy
# .worktree-carry.example to make your own.
.worktree-carry
